# ---------------------------------------------------------------------------
# Supabase — browser/SSR client (@supabase/ssr)
# Used by the app's pages, Server Components, and Server Actions.
# Find these in your Supabase project: Settings -> API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ---------------------------------------------------------------------------
# Admin allowlist — REQUIRED for admin access.
# Comma-separated list of emails that get the full /dashboard admin app. Anyone
# signing in whose email is NOT listed is treated as a customer or portal user.
# Admin status lives ONLY here (never in the database), so customers can never
# promote themselves. If this is empty, NO ONE can reach the admin dashboard.
# ---------------------------------------------------------------------------
ADMIN_EMAILS=admin@tdstudiosny.com

# ---------------------------------------------------------------------------
# Public site URL — used as metadataBase for absolute OG/manifest URLs.
# In Vercel this can be omitted (VERCEL_URL is used); set it for a custom domain.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# ---------------------------------------------------------------------------
# Supabase — server SDK (@supabase/server) for the API route handlers
# Copy the real values from the Supabase dashboard's "Connect" dialog.
# These use the new API key system (sb_publishable_… / sb_secret_…).
# The SECRET key bypasses RLS — keep it server-only, NEVER commit it.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
# Used to verify user JWTs (asymmetric signing keys):
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# ---------------------------------------------------------------------------
# Resend — transactional email (invoices, portal invites, mylar printing
# request notifications, and PARTNER PORTAL ACTIVITY notifications).
# Server-only. The app degrades gracefully when these are unset: invoice email
# is disabled, portal invites fall back to a one-time temp password, mylar
# printing requests are still stored (just not emailed), and partner portal
# events are still LOGGED to partner_job_events (just not announced).
# Request and partner-activity notifications go to the ADMIN_EMAILS addresses
# above — no separate recipient list is needed. To send partner notifications
# somewhere else instead, insert a partner_notification_settings row for that
# company with an `email_recipients` array (service role only; see CLAUDE.md).
# A send-only ("restricted") Resend key is sufficient and preferred.
# RESEND_FROM_EMAIL must be an address on a domain verified in Resend.
# ---------------------------------------------------------------------------
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=TD Studios <invoices@invoices.tdstudiosny.com>

# ---------------------------------------------------------------------------
# Hashing salt for privacy-preserving visitor identification. OPTIONAL — a
# built-in default is used when unset, so nothing breaks without it. Set it in
# production (any long random string) and rotate it to invalidate old hashes.
# Used by: QR scan logging (qr_scans.ip_hash) and the mylar printing request
# rate limit (mylar_printing_inquiries.submitter_hash). Raw IPs are never
# stored — only a salted, truncated SHA-256.
# ---------------------------------------------------------------------------
QR_SCAN_SALT=

# ---------------------------------------------------------------------------
# Signing key for the /premadedesigns keypad cookie. OPTIONAL — it falls back
# to SUPABASE_SECRET_KEY above, so it only needs setting if you want the
# gallery's unlock cookie signed independently of the database key. The gate
# fails CLOSED when neither is set: the keypad reports that access is not
# configured and no image URLs are ever minted.
# The cookie is httpOnly, SameSite=Strict, scoped to /premadedesigns, and
# valid 30 days. Rotating this value invalidates every existing unlock.
# ---------------------------------------------------------------------------
PREMADE_GALLERY_COOKIE_SECRET=

# Shared account behind the Zaza partner portal's keypad. The 4-digit code
# (0420) unlocks a real Supabase session as this user, so every RLS and
# storage policy still applies. Server-only; the browser never sees these.
# Absent = the portal fails closed.
ZAZA_PORTAL_EMAIL=zaza-portal@example.com
ZAZA_PORTAL_PASSWORD=
